{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incus://isolation/inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "external_actions", "environments"],
  "properties": {
    "schema": { "const": "incus://isolation/inventory/v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "external_actions": { "const": false },
    "environments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/environment" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "network_id", "profile_count", "instance_count", "public_ingress"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "network_id": { "$ref": "#/$defs/id" },
        "profile_count": { "type": "integer", "minimum": 1 },
        "instance_count": { "type": "integer", "minimum": 0 },
        "public_ingress": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "connection_status", "management_endpoint_exposed", "projects"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "connection_status": { "enum": ["observed", "not-connected"] },
        "management_endpoint_exposed": { "type": "boolean" },
        "projects": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/project" }
        }
      }
    }
  }
}
